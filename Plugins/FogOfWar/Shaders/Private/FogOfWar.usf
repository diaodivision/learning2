bool IsGridInVision(int2 GridPos)
{
    if (NumVisionStart * 2 != NumVision)
    {
        return false;
    }

    for (uint i = 0; i < NumVisionStart; i++)
    {
        float2 StartPos = VisionStartPosBuffer[i];
        float2 VisionLeft = VisionBuffer[i * 2];
        float2 VisionRight = VisionBuffer[i * 2 + 1];
        int RadiusSq = RadiusSqBuffer[i];

        float2 GridDirection = float2(GridPos.x - StartPos.x, GridPos.y - StartPos.y);

        float CrossLeft = VisionLeft.x * GridDirection.y - VisionLeft.y * GridDirection.x;
        float CrossRight = GridDirection.x * VisionRight.y - GridDirection.y * VisionRight.x;
        
        if (CrossLeft > 0 && CrossRight > 0)
        {
            return true;
        }
        
        if ((pow(StartPos.x - GridPos.x, 2) + pow(StartPos.y - GridPos.y, 2)) <= RadiusSq)
        {
            return true;
        }
    }

    return false;
}

