bool CheckLineOfSight(int2 Start, int2 End, int MaxSteps)
{
    int2 Delta = End - Start;
    float Steps = max(abs(Delta.x), abs(Delta.y));
    
    if (Steps == 0)
        return true;
    
    float2 Step = float2(Delta.x, Delta.y) / Steps;
    float2 Current = float2(Start.x, Start.y);
    
    for (int i = 0; i <= (int) Steps && i < MaxSteps; i++)
    {
        int2 Pos = int2(round(Current.x), round(Current.y));
        
        if (GetGridHeight(Pos.x, Pos.y) != 0)
        {
            return false; // Óöµ½ÕÏ°­
        }
        
        Current += Step;
    }
    
    return true;
}