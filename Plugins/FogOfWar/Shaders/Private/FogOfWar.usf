int GetGridHeight(int2 XY)
{
    return WorldHeightTexture[XY].r > 0 ? 1 : 0;
}

bool CheckLineOfSight(int2 Start, int2 End, int MaxSteps)
{
    int2 Delta = End - Start;
    float Steps = max(abs(Delta.x), abs(Delta.y));
    
    if (Steps == 0)
        return true;
    
    float2 Step = float2(Delta) / Steps;
    
    // 修正 1：加上 0.5 偏移，让射线从网格中心出发，避免边缘精度抖动
    float2 Current = float2(Start) + 0.5f;
    
    for (int i = 0; i <= (int) Steps && i < MaxSteps; i++)
    {
        // 修正 2：使用 floor() 严格划分网格区间，彻底解决负数舍入断层
        int2 Pos = int2(floor(Current));
        
        // 修正 3：确保 GetGridHeight 内部有边界检查 (Pos.x >= 0 && Pos.x < Width 等)
        if (GetGridHeight(Pos) != 0)
        {
            return false; // 遇到障碍
        }
        
        Current += Step;
    }
    
    return true;
}