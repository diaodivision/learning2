struct FBresenhamAlgoData
{
    int2 Current;
    int2 End;
    int2 Delta;
    int2 Step;
    int Error;
    bool bSteep;
};

FBresenhamAlgoData CreateBresenhamAlgoData(int2 Start, int2 End)
{
    FBresenhamAlgoData Data;
    
    Data.Current = Start;
    Data.End = End;
    
    int2 Delta = abs(End - Start);
    Data.Delta = Delta;
    
    Data.Step = int2(
        (End.x > Start.x) ? 1 : -1,
        (End.y > Start.y) ? 1 : -1
    );
    
    Data.Error = Delta.x - Delta.y;
    Data.bSteep = (Delta.y > Delta.x);
    
    return Data;
}

FBresenhamAlgoData GetNextBresenhamAlgoDataPos(FBresenhamAlgoData Data)
{
    if (Data.Current.x == Data.End.x && Data.Current.y == Data.End.y)
    {
        return Data;
    }
    
    int error = Data.Error;
    
    if (error * 2 > -Data.Delta.y)
    {
        error -= Data.Delta.y;
        Data.Current.x += Data.Step.x;
    }
    
    if (error * 2 < Data.Delta.x)
    {
        error += Data.Delta.x;
        Data.Current.y += Data.Step.y;
    }
    
    Data.Error = error;
    
    return Data;
}
